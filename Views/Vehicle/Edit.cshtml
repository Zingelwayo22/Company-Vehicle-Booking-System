@model CompanyVehicleBookingSystem.Models.Vehicle

@{
    ViewBag.Title = "Edit Vehicle";
}

<div class="vehicle-form-page">

    
    <!-- PAGE HEADER -->
    <div class="page-header-modern">

        <div>
            <div class="page-eyebrow">
                FLEET MANAGEMENT
            </div>

            <h1>
                Edit Vehicle
            </h1>

            <p>
                Update vehicle information, compliance details and the vehicle photo.
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "← Back to Vehicles",
                "Index",
                "Vehicle",
                null,
                new { @class = "btn-modern-secondary" }
            )
        </div>

    </div>


    <!-- FORM -->
    @using (Html.BeginForm(
        "Edit",
        "Vehicle",
        FormMethod.Post,
        new
        {
            enctype = "multipart/form-data",
            @class = "vehicle-form-card"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.VehicleId)

        @Html.HiddenFor(model => model.DateAdded)

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "alert alert-danger" }
        )


        <!-- VEHICLE INFORMATION -->
        <div class="vehicle-form-section">

            <div class="vehicle-form-section-title">

                <div class="vehicle-form-section-icon">
                    🚗
                </div>

                <div>
                    <h3>
                        Vehicle Information
                    </h3>

                    <p>
                        Update the basic details of the company vehicle.
                    </p>
                </div>

            </div>


            <div class="vehicle-form-grid">

                <!-- REGISTRATION -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.RegistrationNumber
                    )

                    @Html.EditorFor(
                        model => model.RegistrationNumber,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control",
                                placeholder = "e.g. ND 12345"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.RegistrationNumber,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- MAKE -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.Make
                    )

                    @Html.EditorFor(
                        model => model.Make,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control",
                                placeholder = "e.g. Toyota"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Make,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- MODEL -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.Model
                    )

                    @Html.EditorFor(
                        model => model.Model,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control",
                                placeholder = "e.g. Hilux"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Model,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- YEAR -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.Year
                    )

                    @Html.EditorFor(
                        model => model.Year,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control",
                                placeholder = "e.g. 2024"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Year,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- COLOUR -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.Colour
                    )

                    @Html.EditorFor(
                        model => model.Colour,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control",
                                placeholder = "e.g. White"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Colour,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- VIN -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.VIN
                    )

                    @Html.EditorFor(
                        model => model.VIN,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control",
                                placeholder = "Vehicle Identification Number"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.VIN,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

            </div>

        </div>


        <!-- VEHICLE PHOTO -->
        <div class="vehicle-form-section">

            <div class="vehicle-form-section-title">

                <div class="vehicle-form-section-icon">
                    📸
                </div>

                <div>
                    <h3>
                        Vehicle Photo
                    </h3>

                    <p>
                        View the current photo or upload a replacement.
                    </p>
                </div>

            </div>


            <div class="vehicle-photo-upload">


                <!-- CURRENT PHOTO -->
                <div class="vehicle-photo-preview">

                    @if (!String.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Url.Content(Model.ImagePath)"
                             alt="@Model.Make @Model.Model"
                             id="vehiclePhotoPreview" />
                    }
                    else
                    {
                        <div id="vehiclePhotoPlaceholder">
                            🚗
                        </div>
                    }

                </div>


                <!-- UPLOAD -->
                <div class="vehicle-photo-input">

                    <label for="vehicleImage"
                           class="vehicle-upload-button">

                        📷 Choose New Vehicle Photo

                    </label>


                    <input type="file"
                           id="vehicleImage"
                           name="vehicleImage"
                           accept=".jpg,.jpeg,.png,.webp"
                           style="display:none;" />


                    <p id="selectedPhotoName">
                        No new photo selected
                    </p>


                    <small>
                        Leave this empty to keep the current photo.
                    </small>

                </div>

            </div>

        </div>


        <!-- COMPLIANCE AND SERVICE -->
        <div class="vehicle-form-section">

            <div class="vehicle-form-section-title">

                <div class="vehicle-form-section-icon">
                    📅
                </div>

                <div>
                    <h3>
                        Compliance & Service
                    </h3>

                    <p>
                        Update important vehicle dates.
                    </p>
                </div>

            </div>


            <div class="vehicle-form-grid">


                <!-- INSURANCE -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.InsuranceExpiry
                    )

                    @Html.EditorFor(
                        model => model.InsuranceExpiry,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.InsuranceExpiry,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- LICENCE -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.LicenceDiskExpiry
                    )

                    @Html.EditorFor(
                        model => model.LicenceDiskExpiry,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.LicenceDiskExpiry,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- LAST SERVICE -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.LastServiceDate
                    )

                    @Html.EditorFor(
                        model => model.LastServiceDate,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.LastServiceDate,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- NEXT SERVICE -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.NextServiceDate
                    )

                    @Html.EditorFor(
                        model => model.NextServiceDate,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "modern-form-control"
                            }
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.NextServiceDate,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

            </div>

        </div>


        <!-- STATUS AND NOTES -->
        <div class="vehicle-form-section">

            <div class="vehicle-form-section-title">

                <div class="vehicle-form-section-icon">
                    ⚙
                </div>

                <div>
                    <h3>
                        Vehicle Status
                    </h3>

                    <p>
                        Update the current operational status.
                    </p>
                </div>

            </div>


            <div class="vehicle-form-grid">


                <!-- STATUS -->
                <div class="modern-form-group">

                    @Html.LabelFor(
                        model => model.Status
                    )

                    @Html.DropDownListFor(
                        model => model.Status,
                        new SelectList(
                            new[]
                            {
                                "Available",
                                "Maintenance",
                                "Inactive"
                            },
                            Model.Status
                        ),
                        new
                        {
                            @class = "modern-form-control"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Status,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>


                <!-- NOTES -->
                <div class="modern-form-group modern-form-full">

                    @Html.LabelFor(
                        model => model.Notes
                    )

                    @Html.TextAreaFor(
                        model => model.Notes,
                        new
                        {
                            @class = "modern-form-control",
                            rows = "4",
                            placeholder = "Enter any additional vehicle notes..."
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Notes,
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="vehicle-form-actions">

            @Html.ActionLink(
                "Cancel",
                "Index",
                "Vehicle",
                null,
                new { @class = "btn-modern-secondary" }
            )


            <button type="submit"
                    class="btn-modern-primary">

                ✓ Save Vehicle Changes

            </button>

        </div>

    }
    

</div>
