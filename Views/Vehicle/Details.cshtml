@model CompanyVehicleBookingSystem.Models.Vehicle

@{
    ViewBag.Title = "Vehicle Details";
}

<div class="vehicle-details-page">

    <!-- PAGE HEADER -->
    <div class="page-header-modern">

        <div>
            <span class="page-eyebrow">FLEET ADMINISTRATION</span>

            <h2>
                Vehicle Details
            </h2>

            <p>
                View the complete information and compliance details for this company vehicle.
            </p>
        </div>

        <div class="header-actions">

            @Html.ActionLink(
                "Edit Vehicle",
                "Edit",
                "Vehicle",
                new { id = Model.VehicleId },
                new { @class = "btn-modern btn-primary-modern" }
            )

            @Html.ActionLink(
                "Back to Vehicles",
                "Index",
                "Vehicle",
                null,
                new { @class = "btn-modern btn-secondary-modern" }
            )

        </div>

    </div>


    <!-- VEHICLE HERO -->
    <div class="vehicle-hero-card">

        <div class="vehicle-image-section">

            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
            {
                <img src="@Url.Content(Model.ImagePath)"
                     alt="@Model.RegistrationNumber"
                     class="vehicle-main-image" />
            }
            else
            {
                <div class="vehicle-image-placeholder">
                    <span>🚗</span>
                    <small>No vehicle image available</small>
                </div>
            }

        </div>


        <div class="vehicle-hero-information">

            <div class="vehicle-title-row">

                <div>

                    <span class="vehicle-label">
                        COMPANY VEHICLE
                    </span>

                    <h1>
                        @Model.Make @Model.Model
                    </h1>

                    <div class="registration-badge">
                        @Model.RegistrationNumber
                    </div>

                </div>


                <div class="status-area">

                    @if (Model.Status == "Available")
                    {
                        <span class="status-badge status-available">
                            Available
                        </span>
                    }
                    else if (Model.Status == "Booked")
                    {
                        <span class="status-badge status-booked">
                            Booked
                        </span>
                    }
                    else if (Model.Status == "Maintenance")
                    {
                        <span class="status-badge status-maintenance">
                            Maintenance
                        </span>
                    }
                    else if (Model.Status == "Inactive")
                    {
                        <span class="status-badge status-inactive">
                            Inactive
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-default">
                            @Model.Status
                        </span>
                    }

                </div>

            </div>


            <div class="vehicle-quick-info">

                <div class="quick-item">
                    <span class="quick-label">YEAR</span>
                    <strong>@Model.Year</strong>
                </div>

                <div class="quick-item">
                    <span class="quick-label">COLOUR</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Colour)
                            ? "Not specified"
                            : Model.Colour)
                    </strong>
                </div>

                <div class="quick-item">
                    <span class="quick-label">VIN</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.VIN)
                            ? "Not specified"
                            : Model.VIN)
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- VEHICLE INFORMATION -->
    <div class="details-grid">

        <!-- BASIC INFORMATION -->
        <div class="details-card">

            <div class="card-header-modern">

                <div class="card-icon">
                    🚗
                </div>

                <div>
                    <h3>Vehicle Information</h3>
                    <p>Basic vehicle identification details.</p>
                </div>

            </div>

            <div class="information-list">

                <div class="information-row">
                    <span>Registration Number</span>
                    <strong>
                        @Model.RegistrationNumber
                    </strong>
                </div>

                <div class="information-row">
                    <span>Make</span>
                    <strong>
                        @Model.Make
                    </strong>
                </div>

                <div class="information-row">
                    <span>Model</span>
                    <strong>
                        @Model.Model
                    </strong>
                </div>

                <div class="information-row">
                    <span>Year</span>
                    <strong>
                        @Model.Year
                    </strong>
                </div>

                <div class="information-row">
                    <span>Colour</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Colour)
                            ? "Not specified"
                            : Model.Colour)
                    </strong>
                </div>

                <div class="information-row">
                    <span>VIN</span>
                    <strong class="break-word">
                        @(string.IsNullOrWhiteSpace(Model.VIN)
                            ? "Not specified"
                            : Model.VIN)
                    </strong>
                </div>

            </div>

        </div>


        <!-- COMPLIANCE -->
        <div class="details-card">

            <div class="card-header-modern">

                <div class="card-icon">
                    🛡️
                </div>

                <div>
                    <h3>Compliance</h3>
                    <p>Insurance and licence information.</p>
                </div>

            </div>

            <div class="information-list">

                <div class="information-row">

                    <span>Insurance Expiry</span>

                    <strong>
                        @(Model.InsuranceExpiry.HasValue
                            ? Model.InsuranceExpiry.Value.ToString("dd/MM/yyyy")
                            : "Not set")
                    </strong>

                </div>


                <div class="information-row">

                    <span>Licence Disk Expiry</span>

                    <strong>
                        @(Model.LicenceDiskExpiry.HasValue
                            ? Model.LicenceDiskExpiry.Value.ToString("dd/MM/yyyy")
                            : "Not set")
                    </strong>

                </div>


                <div class="information-row">

                    <span>Vehicle Status</span>

                    <strong>
                        @Model.Status
                    </strong>

                </div>


                <div class="information-row">

                    <span>Date Added</span>

                    <strong>
                        @Model.DateAdded.ToString("dd/MM/yyyy")
                    </strong>

                </div>

            </div>

        </div>


        <!-- SERVICE INFORMATION -->
        <div class="details-card">

            <div class="card-header-modern">

                <div class="card-icon">
                    🔧
                </div>

                <div>
                    <h3>Service Information</h3>
                    <p>Vehicle maintenance history and schedule.</p>
                </div>

            </div>

            <div class="information-list">

                <div class="information-row">

                    <span>Last Service</span>

                    <strong>
                        @(Model.LastServiceDate.HasValue
                            ? Model.LastServiceDate.Value.ToString("dd/MM/yyyy")
                            : "Not recorded")
                    </strong>

                </div>


                <div class="information-row">

                    <span>Next Service</span>

                    <strong>
                        @(Model.NextServiceDate.HasValue
                            ? Model.NextServiceDate.Value.ToString("dd/MM/yyyy")
                            : "Not scheduled")
                    </strong>

                </div>

            </div>

        </div>


        <!-- NOTES -->
        <div class="details-card">

            <div class="card-header-modern">

                <div class="card-icon">
                    📝
                </div>

                <div>
                    <h3>Vehicle Notes</h3>
                    <p>Additional information recorded for this vehicle.</p>
                </div>

            </div>

            <div class="notes-container">

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p>
                        @Model.Notes
                    </p>
                }
                else
                {
                    <div class="empty-notes">
                        <span>ℹ️</span>
                        <p>No additional notes have been recorded for this vehicle.</p>
                    </div>
                }

            </div>

        </div>

    </div>


    <!-- BOTTOM ACTIONS -->
    <div class="bottom-actions">

        @Html.ActionLink(
            "Edit Vehicle",
            "Edit",
            "Vehicle",
            new { id = Model.VehicleId },
            new { @class = "btn-modern btn-primary-modern" }
        )

        @Html.ActionLink(
            "Back to Vehicle List",
            "Index",
            "Vehicle",
            null,
            new { @class = "btn-modern btn-secondary-modern" }
        )

    </div>

</div>


<style>

    .vehicle-details-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 10px 0 40px;
    }

    /* PAGE HEADER */

    .page-header-modern {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 30px;
        margin-bottom: 25px;
    }

    .page-eyebrow {
        display: block;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .page-header-modern h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #172033;
    }

    .page-header-modern p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }


    /* BUTTONS */

    .btn-modern {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none !important;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

    .btn-primary-modern {
        background: #2563eb;
        color: #ffffff !important;
    }

        .btn-primary-modern:hover {
            background: #1d4ed8;
            color: #ffffff !important;
        }

    .btn-secondary-modern {
        background: #ffffff;
        border-color: #d1d5db;
        color: #374151 !important;
    }

        .btn-secondary-modern:hover {
            background: #f3f4f6;
            color: #111827 !important;
        }


    /* HERO */

    .vehicle-hero-card {
        display: grid;
        grid-template-columns: 380px 1fr;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }

    .vehicle-image-section {
        min-height: 280px;
        background: #f3f4f6;
    }

    .vehicle-main-image {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 280px;
        object-fit: cover;
    }

    .vehicle-image-placeholder {
        min-height: 280px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
    }

        .vehicle-image-placeholder span {
            font-size: 65px;
            margin-bottom: 10px;
        }

        .vehicle-image-placeholder small {
            font-size: 13px;
        }

    .vehicle-hero-information {
        padding: 32px;
    }

    .vehicle-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .vehicle-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .vehicle-title-row h1 {
        margin: 0 0 12px;
        color: #111827;
        font-size: 30px;
        font-weight: 700;
    }

    .registration-badge {
        display: inline-block;
        padding: 7px 13px;
        background: #111827;
        color: #ffffff;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.8px;
    }


    /* STATUS */

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-available {
        background: #dcfce7;
        color: #166534;
    }

    .status-booked {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-maintenance {
        background: #fef3c7;
        color: #92400e;
    }

    .status-inactive {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-default {
        background: #f3f4f6;
        color: #374151;
    }


    /* QUICK INFO */

    .vehicle-quick-info {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #e5e7eb;
    }

    .quick-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    .quick-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #9ca3af;
    }

    .quick-item strong {
        color: #1f2937;
        font-size: 14px;
        word-break: break-word;
    }


    /* DETAILS GRID */

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .details-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    }

    .card-header-modern {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 22px;
        border-bottom: 1px solid #e5e7eb;
        background: #fafafa;
    }

    .card-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        flex-shrink: 0;
    }

    .card-header-modern h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: #1f2937;
    }

    .card-header-modern p {
        margin: 3px 0 0;
        font-size: 12px;
        color: #6b7280;
    }


    /* INFORMATION LIST */

    .information-list {
        padding: 5px 22px 10px;
    }

    .information-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding: 14px 0;
        border-bottom: 1px solid #f0f1f3;
    }

        .information-row:last-child {
            border-bottom: none;
        }

        .information-row span {
            color: #6b7280;
            font-size: 13px;
        }

        .information-row strong {
            color: #1f2937;
            font-size: 13px;
            text-align: right;
        }

    .break-word {
        word-break: break-all;
        max-width: 60%;
    }


    /* NOTES */

    .notes-container {
        padding: 22px;
    }

        .notes-container > p {
            margin: 0;
            color: #374151;
            font-size: 14px;
            line-height: 1.7;
            white-space: pre-line;
        }

    .empty-notes {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

        .empty-notes span {
            font-size: 18px;
        }

        .empty-notes p {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
        }


    /* BOTTOM ACTIONS */

    .bottom-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }


    /* RESPONSIVE */

    @@media (max-width: 1000px) {

        .vehicle-hero-card {
            grid-template-columns: 300px 1fr;
        }

        .vehicle-title-row h1 {
            font-size: 25px;
        }
    }


    @@media (max-width: 768px) {

        .vehicle-details-page {
            padding: 5px 0 30px;
        }

        .page-header-modern {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
        }

            .header-actions .btn-modern {
                flex: 1;
            }

        .vehicle-hero-card {
            grid-template-columns: 1fr;
        }

        .vehicle-image-section {
            min-height: 230px;
        }

        .vehicle-main-image {
            min-height: 230px;
            max-height: 300px;
        }

        .vehicle-image-placeholder {
            min-height: 230px;
        }

        .vehicle-hero-information {
            padding: 24px;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 520px) {

        .page-header-modern h2 {
            font-size: 25px;
        }

        .page-header-modern p {
            line-height: 1.5;
        }

        .header-actions {
            flex-direction: column;
        }

            .header-actions .btn-modern {
                width: 100%;
            }

        .vehicle-title-row {
            flex-direction: column;
        }

            .vehicle-title-row h1 {
                font-size: 23px;
            }

        .vehicle-quick-info {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .information-row {
            flex-direction: column;
            gap: 5px;
        }

            .information-row strong {
                text-align: left;
            }

        .break-word {
            max-width: 100%;
        }

        .bottom-actions {
            flex-direction: column;
        }

            .bottom-actions .btn-modern {
                width: 100%;
            }
    }
</style>