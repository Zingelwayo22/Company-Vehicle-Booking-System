@model CompanyVehicleBookingSystem.Models.ApplicationUser

@{
    ViewBag.Title = "Add Employee";
}

<div class="container">

    <h2>Add Employee</h2>

    <p class="text-muted">
        Add a company employee to the vehicle booking system.
    </p>

    <hr />

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row">

            <div class="col-md-6">

                <div class="form-group">
                    @Html.LabelFor(model => model.EmployeeNumber)
                    @Html.EditorFor(model => model.EmployeeNumber,
                        new { htmlAttributes = new { @class = "form-control" } })

                    @Html.ValidationMessageFor(model => model.EmployeeNumber,
                        "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.FirstName)
                    @Html.EditorFor(model => model.FirstName,
                        new { htmlAttributes = new { @class = "form-control" } })

                    @Html.ValidationMessageFor(model => model.FirstName,
                        "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.LastName)
                    @Html.EditorFor(model => model.LastName,
                        new { htmlAttributes = new { @class = "form-control" } })

                    @Html.ValidationMessageFor(model => model.LastName,
                        "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Position)
                    @Html.EditorFor(model => model.Position,
                        new { htmlAttributes = new { @class = "form-control" } })

                    @Html.ValidationMessageFor(model => model.Position,
                        "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.DepartmentId)

                    @Html.DropDownList(
                        "DepartmentId",
                        null,
                        "-- Select Department --",
                        new { @class = "form-control" }
                    )

                    @Html.ValidationMessageFor(model => model.DepartmentId,
                        "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="col-md-6">

                <div class="form-group">
                    <label>Email Address</label>

                    <input type="email"
                           name="Email"
                           class="form-control"
                           required />
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.PhoneNumber)
                    @Html.EditorFor(model => model.PhoneNumber,
                        new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.DriversLicenceNumber)

                    @Html.EditorFor(model => model.DriversLicenceNumber,
                        new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.DriversLicenceExpiry)

                    @Html.EditorFor(model => model.DriversLicenceExpiry,
                        new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control",
                                type = "date"
                            }
                        })
                </div>

                <div class="form-group">
                    <label>Vehicle Booking Permission</label>

                    <div class="checkbox">
                        <label>
                            <input type="checkbox"
                                   name="IsVehicleBookingAllowed"
                                   value="true" />

                            Employee is allowed to book company vehicles
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Account Status</label>

                    <div class="checkbox">
                        <label>
                            <input type="checkbox"
                                   name="IsActive"
                                   value="true"
                                   checked />

                            Account is active
                        </label>
                    </div>
                </div>

            </div>

        </div>

        <hr />

        <button type="submit" class="btn btn-primary">
            Add Employee
        </button>

        <a href="@Url.Action("Index", "Employee")"
           class="btn btn-default">
            Cancel
        </a>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}