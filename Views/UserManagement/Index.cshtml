@model IEnumerable<CompanyVehicleBookingSystem.Models.ApplicationUser>

@{
    ViewBag.Title = "Employee Management";

    var employees = Model == null
        ? new List<CompanyVehicleBookingSystem.Models.ApplicationUser>()
        : Model.ToList();

    var totalEmployees = employees.Count;
    var activeEmployees = employees.Count(u => u.IsActive);
    var inactiveEmployees = employees.Count(u => !u.IsActive);
    var bookingAllowed = employees.Count(u => u.IsVehicleBookingAllowed);
    var bookingRestricted = employees.Count(u => !u.IsVehicleBookingAllowed);
}

<style>
    .um-page {
        max-width: 1550px;
        margin: 0 auto;
        padding: 10px 10px 45px;
        color: #183247;
    }

    .um-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .um-eyebrow {
        color: #287fd0;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .um-header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 800;
        color: #142f43;
    }

    .um-header p {
        margin: 0;
        color: #788995;
        font-size: 14px;
        line-height: 1.6;
    }

    .um-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 18px;
        background: #287fd0;
        color: #fff !important;
        border-radius: 9px;
        text-decoration: none !important;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
        box-shadow: 0 5px 13px rgba(40,127,208,.18);
        transition: all .2s ease;
    }

        .um-add-button:hover {
            background: #1d68ad;
            transform: translateY(-1px);
        }

    .um-summary {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 28px;
    }

    .um-stat {
        background: #fff;
        border: 1px solid #e4ebf0;
        border-radius: 14px;
        padding: 19px;
        box-shadow: 0 5px 18px rgba(20,47,67,.04);
        min-width: 0;
    }

    .um-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        margin-bottom: 15px;
    }

    .um-icon-total {
        background: #eaf3fb;
    }

    .um-icon-active {
        background: #e5f7ee;
    }

    .um-icon-inactive {
        background: #fdeaea;
    }

    .um-icon-allowed {
        background: #e8f4ff;
    }

    .um-icon-restricted {
        background: #fff4d6;
    }

    .um-stat-label {
        color: #788995;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 7px;
    }

    .um-stat-value {
        color: #142f43;
        font-size: 27px;
        line-height: 1.1;
        font-weight: 800;
    }

    .um-table-card {
        background: #fff;
        border: 1px solid #e3eaf0;
        border-radius: 17px;
        overflow: hidden;
        box-shadow: 0 7px 25px rgba(20,47,67,.05);
    }

    .um-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf1f4;
    }

        .um-table-header h2 {
            margin: 0 0 5px;
            color: #142f43;
            font-size: 19px;
            font-weight: 800;
        }

        .um-table-header p {
            margin: 0;
            color: #788995;
            font-size: 12px;
        }

    .um-count-badge {
        padding: 8px 12px;
        background: #eef4f8;
        color: #365469;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .um-table-wrapper {
        overflow-x: auto;
    }

    .um-table {
        width: 100%;
        min-width: 1050px;
        margin: 0;
        border-collapse: collapse;
    }

        .um-table thead {
            background: #f7f9fb;
        }

        .um-table th {
            padding: 14px 17px;
            text-align: left;
            border-bottom: 1px solid #e6edf1;
            color: #718391;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .6px;
            white-space: nowrap;
        }

        .um-table td {
            padding: 16px 17px;
            border-bottom: 1px solid #edf1f4;
            color: #365064;
            font-size: 12px;
            vertical-align: middle;
        }

        .um-table tbody tr {
            transition: background .2s ease;
        }

            .um-table tbody tr:hover {
                background: #f9fbfc;
            }

            .um-table tbody tr:last-child td {
                border-bottom: none;
            }

    .um-employee {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 190px;
    }

    .um-avatar {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eaf3fb;
        color: #287fd0;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .um-employee-name {
        color: #183247;
        font-size: 12px;
        font-weight: 800;
        line-height: 1.5;
    }

    .um-employee-label {
        color: #8997a2;
        font-size: 10px;
        margin-top: 2px;
    }

    .um-employee-number {
        display: inline-block;
        padding: 6px 9px;
        border: 1px solid #e1e8ed;
        border-radius: 6px;
        background: #f5f8fa;
        color: #365469;
        font-size: 11px;
        font-weight: 700;
    }

    .um-department {
        color: #365469;
        font-weight: 600;
    }

    .um-muted {
        color: #9aa6af;
        font-size: 11px;
    }

    .um-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .um-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .um-status-active {
        background: #e5f7ee;
        color: #16804f;
    }

    .um-status-inactive {
        background: #fdeaea;
        color: #bf3939;
    }

    .um-status-allowed {
        background: #eaf3fb;
        color: #287fd0;
    }

    .um-status-restricted {
        background: #fff4d6;
        color: #986400;
    }

    .um-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .um-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 10px;
        border-radius: 7px;
        text-decoration: none !important;
        font-size: 10px;
        font-weight: 800;
        border: 1px solid transparent;
        transition: all .2s ease;
    }

    .um-action-view {
        background: #eaf3fb;
        color: #287fd0 !important;
    }

        .um-action-view:hover {
            background: #287fd0;
            color: #fff !important;
        }

    .um-action-edit {
        background: #fff4d6;
        color: #946300 !important;
    }

        .um-action-edit:hover {
            background: #f0dca7;
        }

    .um-action-manage {
        background: #e5f7ee;
        color: #16804f !important;
    }

        .um-action-manage:hover {
            background: #16804f;
            color: #fff !important;
        }

    .um-action-delete {
        background: #fff;
        border-color: #f0d5d5;
        color: #bd3d3d !important;
    }

        .um-action-delete:hover {
            background: #fdeaea;
        }

    .um-empty {
        text-align: center;
        padding: 65px 25px;
    }

    .um-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        background: #edf4f9;
        font-size: 33px;
    }

    .um-empty h3 {
        margin: 0 0 9px;
        color: #183247;
        font-size: 20px;
        font-weight: 800;
    }

    .um-empty p {
        max-width: 450px;
        margin: 0 auto 20px;
        color: #788995;
        font-size: 13px;
        line-height: 1.7;
    }

    .um-footer {
        padding: 16px 24px;
        border-top: 1px solid #edf1f4;
        background: #fafcfd;
        color: #788995;
        font-size: 11px;
    }

    @@media (max-width: 1200px) {
        .um-summary {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .um-page {
            padding: 5px 5px 35px;
        }

        .um-header {
            flex-direction: column;
            align-items: stretch;
        }

            .um-header h1 {
                font-size: 27px;
            }

        .um-add-button {
            align-self: flex-start;
        }

        .um-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .um-stat {
            padding: 15px;
        }

        .um-stat-value {
            font-size: 24px;
        }

        .um-table-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 19px;
        }
    }

    @@media (max-width: 420px) {
        .um-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="um-page">

    <div class="um-header">
        <div>
            <div class="um-eyebrow">ADMINISTRATION / PEOPLE</div>
            <h1>Employee Management</h1>
            <p>
                Manage employee accounts, organisational assignments
                and company vehicle booking permissions.
            </p>
        </div>

        @Html.ActionLink(
            "+ Add Employee",
            "Create",
            "UserManagement",
            null,
            new { @class = "um-add-button" }
        )
    </div>

    <div class="um-summary">

        <div class="um-stat">
            <div class="um-stat-icon um-icon-total">👥</div>
            <div class="um-stat-label">Total Employees</div>
            <div class="um-stat-value">@totalEmployees</div>
        </div>

        <div class="um-stat">
            <div class="um-stat-icon um-icon-active">✓</div>
            <div class="um-stat-label">Active Accounts</div>
            <div class="um-stat-value">@activeEmployees</div>
        </div>

        <div class="um-stat">
            <div class="um-stat-icon um-icon-inactive">!</div>
            <div class="um-stat-label">Inactive Accounts</div>
            <div class="um-stat-value">@inactiveEmployees</div>
        </div>

        <div class="um-stat">
            <div class="um-stat-icon um-icon-allowed">🚗</div>
            <div class="um-stat-label">Booking Allowed</div>
            <div class="um-stat-value">@bookingAllowed</div>
        </div>

        <div class="um-stat">
            <div class="um-stat-icon um-icon-restricted">🔒</div>
            <div class="um-stat-label">Booking Restricted</div>
            <div class="um-stat-value">@bookingRestricted</div>
        </div>

    </div>

    <div class="um-table-card">

        <div class="um-table-header">
            <div>
                <h2>Employee Directory</h2>
                <p>Employee accounts and vehicle booking access.</p>
            </div>

            <div class="um-count-badge">
                @totalEmployees employee(s)
            </div>
        </div>

        @if (!employees.Any())
        {
            <div class="um-empty">
                <div class="um-empty-icon">👥</div>
                <h3>No Employees Found</h3>
                <p>
                    There are no employee accounts to display.
                    Add an employee to begin managing company access.
                </p>

                @Html.ActionLink(
                    "+ Add First Employee",
                    "Create",
                    "UserManagement",
                    null,
                    new { @class = "um-add-button" }
                )
            </div>
        }
        else
        {
            <div class="um-table-wrapper">
                <table class="um-table">

                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Employee Number</th>
                            <th>Department</th>
                            <th>Account Status</th>
                            <th>Vehicle Booking</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in employees)
                        {
                            var firstName = user.FirstName ?? "";
                            var lastName = user.LastName ?? "";

                            var initials =
                                (firstName.Length > 0
                                    ? firstName.Substring(0, 1)
                                    : "") +
                                (lastName.Length > 0
                                    ? lastName.Substring(0, 1)
                                    : "");

                            if (String.IsNullOrWhiteSpace(initials))
                            {
                                initials = "U";
                            }

                            <tr>
                                <td>
                                    <div class="um-employee">
                                        <div class="um-avatar">
                                            @initials.ToUpper()
                                        </div>

                                        <div>
                                            <div class="um-employee-name">
                                                @if (String.IsNullOrWhiteSpace(firstName) &&
                                                     String.IsNullOrWhiteSpace(lastName))
                                                {
                                                    <text>Unnamed Employee</text>
                                                }
                                                else
                                                {
                                                    @firstName @: @lastName
                                                }
                                            </div>

                                            <div class="um-employee-label">
                                                Company Employee
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (!String.IsNullOrWhiteSpace(user.EmployeeNumber))
                                    {
                                        <span class="um-employee-number">
                                            @user.EmployeeNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="um-muted">Not assigned</span>
                                    }
                                </td>

                                <td>
                                    @if (user.Department != null)
                                    {
                                        <span class="um-department">
                                            @user.Department.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="um-muted">Not assigned</span>
                                    }
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="um-status um-status-active">
                                            <span class="um-status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="um-status um-status-inactive">
                                            <span class="um-status-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (user.IsVehicleBookingAllowed)
                                    {
                                        <span class="um-status um-status-allowed">
                                            <span class="um-status-dot"></span>
                                            Allowed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="um-status um-status-restricted">
                                            <span class="um-status-dot"></span>
                                            Restricted
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="um-actions">
                                        @Html.ActionLink(
                                            "View",
                                            "Details",
                                            "UserManagement",
                                            new { id = user.Id },
                                            new { @class = "um-action um-action-view" }
                                        )

                                        @Html.ActionLink(
                                            "Edit",
                                            "Edit",
                                            new { id = user.Id },
                                            new { @class = "um-action um-action-edit" }
                                        )

                                        @Html.ActionLink(
                                            "Manage",
                                            "Manage",
                                            "UserManagement",
                                            new { id = user.Id },
                                            new { @class = "um-action um-action-manage" }
                                        )

                                        @Html.ActionLink(
                                            "Delete",
                                            "Delete",
                                            "UserManagement",
                                            new { id = user.Id },
                                            new { @class = "um-action um-action-delete" }
                                        )
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="um-footer">
                Displaying <strong>@totalEmployees</strong> employee account(s).
                Account activity and booking permissions are shown separately.
            </div>
        }

    </div>
</div>