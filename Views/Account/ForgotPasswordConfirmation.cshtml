@{
    ViewBag.Title = "Password Reset Confirmation";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset Confirmation | Company Vehicle Booking System</title>

    @Styles.Render("~/Content/css")

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        .page-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
        }

        .confirmation-card {
            width: 100%;
            max-width: 780px;
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            overflow: hidden;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .12);
        }

        .brand-panel {
            padding: 40px 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: #fff;
            background: linear-gradient(145deg, #102a43, #176b87);
        }

        .brand-icon {
            width: 62px;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 16px;
            background: rgba(255,255,255,.12);
            font-size: 29px;
        }

        .brand-panel h1 {
            margin: 0 0 15px;
            font-size: 25px;
            line-height: 1.4;
            font-weight: 700;
        }

        .brand-panel p {
            color: #d8e8f2;
            font-size: 13px;
            line-height: 1.8;
        }

        .content-panel {
            padding: 50px 38px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .status-icon {
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            border-radius: 50%;
            background: #e0f2fe;
            color: #126782;
            font-size: 29px;
        }

        .eyebrow {
            margin-bottom: 10px;
            color: #167d9a;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .content-panel h2 {
            margin: 0 0 15px;
            color: #102a43;
            font-size: 28px;
            font-weight: 700;
            line-height: 1.35;
        }

        .message {
            margin: 0 0 20px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.9;
        }

        .help-note {
            margin-bottom: 25px;
            padding: 14px 16px;
            border: 1px solid #dbeafe;
            border-radius: 10px;
            background: #f8fbff;
            color: #475569;
            font-size: 12px;
            line-height: 1.8;
        }

        .primary-button {
            display: block;
            width: 100%;
            padding: 14px 18px;
            border-radius: 9px;
            background: #126782;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: background .2s ease;
        }

            .primary-button:hover {
                background: #0d5269;
                color: #fff;
                text-decoration: none;
            }

        .footer {
            margin-top: 28px;
            color: #94a3b8;
            font-size: 11px;
            text-align: center;
        }

        @@media (max-width: 650px) {
            .confirmation-card {
                max-width: 480px;
                grid-template-columns: 1fr;
            }

            .brand-panel {
                padding: 28px;
            }

            .brand-icon {
                margin-bottom: 15px;
            }

            .brand-panel h1 {
                font-size: 22px;
            }

            .content-panel {
                padding: 35px 25px;
            }

                .content-panel h2 {
                    font-size: 25px;
                }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <div class="confirmation-card">

            <section class="brand-panel">
                <div class="brand-icon">&#128663;</div>

                <h1>Company Vehicle Booking System</h1>

                <p>
                    Secure, organised management of company vehicles
                    and employee bookings.
                </p>
            </section>

            <section class="content-panel">
                <div class="status-icon">&#9993;</div>

                <div class="eyebrow">Account Recovery</div>

                <h2>Check Your Email</h2>

                <p class="message">
                    If your account is eligible for password recovery,
                    please check your email for instructions to reset
                    your password.
                </p>

                <div class="help-note">
                    <strong>Can't find the email?</strong>
                    Check your spam or junk folder. Make sure you entered
                    the email address associated with your account.
                </div>

                <a href="@Url.Action("Login", "Account")"
                   class="primary-button">
                    Return to Sign In
                </a>

                <div class="footer">
                    Company Vehicle Booking System &copy; @DateTime.Now.Year
                </div>
            </section>

        </div>
    </div>
</body>
</html>