@model CompanyVehicleBookingSystem.Models.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Password | Company Vehicle Booking System</title>

    @Styles.Render("~/Content/css")

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        .page-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
        }

        .reset-card {
            width: 100%;
            max-width: 950px;
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            overflow: hidden;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .12);
        }

        .brand-panel {
            padding: 45px 38px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: #fff;
            background: linear-gradient(145deg, #102a43, #176b87);
        }

        .brand-icon {
            width: 66px;
            height: 66px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 28px;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 17px;
            background: rgba(255,255,255,.12);
            font-size: 30px;
        }

        .brand-panel h1 {
            margin: 0 0 16px;
            font-size: 28px;
            line-height: 1.4;
            font-weight: 700;
        }

        .brand-panel p {
            color: #d8e8f2;
            font-size: 14px;
            line-height: 1.9;
        }

        .brand-note {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,.2);
            color: #d8e8f2;
            font-size: 12px;
            line-height: 1.8;
        }

        .form-panel {
            padding: 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .eyebrow {
            margin-bottom: 10px;
            color: #167d9a;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .form-panel h2 {
            margin: 0 0 12px;
            color: #102a43;
            font-size: 28px;
            font-weight: 700;
        }

        .intro-text {
            margin-bottom: 25px;
            color: #718096;
            font-size: 14px;
            line-height: 1.8;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                color: #334155;
                font-size: 13px;
                font-weight: 600;
            }

        .form-control {
            width: 100%;
            height: 47px;
            padding: 10px 13px;
            border: 1px solid #dbe3ed;
            border-radius: 9px;
            background: #fff;
            box-shadow: none;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: #167d9a;
                box-shadow: 0 0 0 3px rgba(22,125,154,.12);
                outline: none;
            }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            color: #dc2626;
            font-size: 12px;
        }

        .validation-summary-errors {
            margin-bottom: 20px;
            padding: 12px 15px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #fef2f2;
            color: #b91c1c;
            font-size: 13px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 18px;
            }

        .validation-summary-valid {
            display: none;
        }

        .submit-button {
            width: 100%;
            min-height: 48px;
            margin-top: 5px;
            border: none;
            border-radius: 9px;
            background: #126782;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s ease;
        }

            .submit-button:hover {
                background: #0d5269;
            }

        .back-link {
            margin-top: 24px;
            text-align: center;
            font-size: 13px;
        }

            .back-link a {
                color: #126782;
                font-weight: 600;
                text-decoration: none;
            }

                .back-link a:hover {
                    text-decoration: underline;
                }

        .footer {
            margin-top: 28px;
            color: #94a3b8;
            font-size: 11px;
            text-align: center;
        }

        @@media (max-width: 760px) {
            .reset-card {
                max-width: 520px;
                grid-template-columns: 1fr;
            }

            .brand-panel {
                padding: 30px;
            }

            .brand-icon {
                margin-bottom: 16px;
            }

            .brand-panel h1 {
                font-size: 24px;
            }

            .form-panel {
                padding: 32px 25px;
            }
        }
    </style>
</head>

<body>
    <div class="page-wrapper">
        <div class="reset-card">

            <section class="brand-panel">
                <div class="brand-icon">&#128274;</div>

                <h1>Company Vehicle Booking System</h1>

                <p>
                    Securely manage your account to access company
                    vehicle bookings and fleet services.
                </p>

                <div class="brand-note">
                    <strong>Protect your account</strong>
                    <br />
                    Choose a strong password that you do not use
                    for other accounts.
                </div>
            </section>

            <section class="form-panel">
                <div class="eyebrow">Account Security</div>

                <h2>Reset Your Password</h2>

                <p class="intro-text">
                    Enter your email address and choose a new password
                    to regain access to your account.
                </p>

                @using (Html.BeginForm(
                    "ResetPassword",
                    "Account",
                    FormMethod.Post,
                    new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        false,
                        "",
                        new { @class = "validation-summary-errors" })

                    @Html.HiddenFor(m => m.Code)

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, "Email Address")

                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            type = "email",
                            placeholder = "name@company.com",
                            autocomplete = "email"
                        })

                        @Html.ValidationMessageFor(
                            m => m.Email,
                            "",
                            new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Password, "New Password")

                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control",
                            placeholder = "Enter a new password",
                            autocomplete = "new-password"
                        })

                        @Html.ValidationMessageFor(
                            m => m.Password,
                            "",
                            new { @class = "field-validation-error" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(
                            m => m.ConfirmPassword,
                            "Confirm New Password")

                        @Html.PasswordFor(m => m.ConfirmPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Re-enter your new password",
                            autocomplete = "new-password"
                        })

                        @Html.ValidationMessageFor(
                            m => m.ConfirmPassword,
                            "",
                            new { @class = "field-validation-error" })
                    </div>

                    <button type="submit" class="submit-button">
                        Reset Password
                    </button>
                }

                <div class="back-link">
                    @Html.ActionLink("Back to Sign In", "Login", "Account")
                </div>

                <div class="footer">
                    Company Vehicle Booking System &copy; @DateTime.Now.Year
                </div>
            </section>

        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>