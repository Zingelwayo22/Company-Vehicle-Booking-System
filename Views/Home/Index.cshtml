@{
    ViewBag.Title = "Home";
}

<style>
    .home-page {
        color: #1e293b;
        padding-bottom: 35px;
    }

    .home-hero {
        position: relative;
        overflow: hidden;
        padding: 48px 42px;
        margin-bottom: 28px;
        border-radius: 18px;
        background: linear-gradient(120deg, #102a43, #176b87);
        color: #fff;
        box-shadow: 0 12px 30px rgba(16, 42, 67, .12);
    }

        .home-hero:after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -70px;
            top: -90px;
            border: 35px solid rgba(255,255,255,.07);
            border-radius: 50%;
        }

    .hero-label {
        display: inline-block;
        padding: 7px 12px;
        margin-bottom: 18px;
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 30px;
        background: rgba(255,255,255,.1);
        color: #e0f2fe;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .home-hero h1 {
        max-width: 650px;
        margin: 0 0 16px;
        color: #fff;
        font-size: 34px;
        font-weight: 700;
        line-height: 1.3;
    }

    .home-hero p {
        max-width: 600px;
        margin: 0;
        color: #d8e8f2;
        font-size: 15px;
        line-height: 1.9;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 27px;
    }

    .hero-button {
        display: inline-block;
        padding: 12px 19px;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

    .hero-button-primary {
        background: #fff;
        color: #102a43;
        border-color: #fff;
    }

    .hero-button:hover {
        background: #e0f2fe;
        border-color: #e0f2fe;
        color: #102a43;
        text-decoration: none;
    }

    .section-heading {
        margin: 32px 0 18px;
    }

        .section-heading h2 {
            margin: 0 0 7px;
            color: #102a43;
            font-size: 21px;
            font-weight: 700;
        }

        .section-heading p {
            margin: 0;
            color: #718096;
            font-size: 13px;
        }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .feature-card {
        display: flex;
        flex-direction: column;
        min-height: 215px;
        padding: 24px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .035);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .feature-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(15, 23, 42, .08);
        }

    .feature-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        margin-bottom: 19px;
        border-radius: 12px;
        background: #e6f4f8;
        color: #126782;
        font-size: 23px;
    }

    .feature-card h3 {
        margin: 0 0 10px;
        color: #102a43;
        font-size: 16px;
        font-weight: 700;
    }

    .feature-card p {
        flex: 1;
        margin: 0 0 18px;
        color: #718096;
        font-size: 13px;
        line-height: 1.8;
    }

    .feature-link {
        color: #126782;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

        .feature-link:hover {
            color: #0d5269;
            text-decoration: underline;
        }

    .home-footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 12px;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .feature-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .home-hero {
            padding: 35px 28px;
        }

            .home-hero h1 {
                font-size: 29px;
            }
    }

    @@media (max-width: 600px) {
        .feature-grid {
            grid-template-columns: 1fr;
        }

        .home-hero {
            padding: 30px 23px;
        }

            .home-hero h1 {
                font-size: 25px;
            }

        .feature-card {
            min-height: auto;
        }
    }
</style>

<div class="home-page">

    <section class="home-hero">
        <div class="hero-label">Company Fleet Management</div>

        @if (Request.IsAuthenticated)
        {
            <h1>
                Welcome to Your Vehicle Management Portal
            </h1>

            <p>
                Manage company vehicle bookings, check fleet availability
                and keep track of your vehicle requests from one central place.
            </p>

            <div class="hero-actions">
                @if (User.IsInRole("Admin"))
                {
                    @Html.ActionLink(
                        "Open Admin Dashboard",
                        "Dashboard",
                        "Booking",
                        null,
                        new { @class = "hero-button hero-button-primary" })
                }
                else
                {
                    @Html.ActionLink(
                        "Request a Vehicle",
                        "Create",
                        "Booking",
                        null,
                        new { @class = "hero-button hero-button-primary" })
                }

                @Html.ActionLink(
                    "View Vehicle Availability",
                    "Availability",
                    "Vehicle",
                    null,
                    new { @class = "hero-button" })
            </div>
        }
        else
        {
            <h1>Smarter Company Vehicle Management</h1>

            <p>
                A central platform for managing company vehicles,
                employee bookings and fleet availability efficiently.
            </p>

            <div class="hero-actions">
                @Html.ActionLink(
                    "Sign In",
                    "Login",
                    "Account",
                    null,
                    new { @class = "hero-button hero-button-primary" })
            </div>
        }
    </section>

    <div class="section-heading">
        <h2>
            @(User.IsInRole("Admin")
                ? "Administration Centre"
                : "Explore Your Vehicle Services")
        </h2>

        <p>
            @(User.IsInRole("Admin")
                ? "Manage bookings, employees and company fleet operations."
                : "Access the tools you need to manage your company vehicle bookings.")
        </p>
    </div>

    <div class="feature-grid">

        @if (User.IsInRole("Admin"))
        {
            <article class="feature-card">
                <div class="feature-icon">&#128203;</div>
                <h3>Booking Management</h3>
                <p>
                    Review requests and manage vehicle booking decisions
                    from one place.
                </p>
                @Html.ActionLink(
                    "Manage Bookings →",
                    "AdminIndex",
                    "Booking",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128663;</div>
                <h3>Fleet Management</h3>
                <p>
                    Maintain vehicle records, registration details,
                    photographs and fleet information.
                </p>
                @Html.ActionLink(
                    "Manage Vehicles →",
                    "Index",
                    "Vehicle",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128101;</div>
                <h3>Employee Management</h3>
                <p>
                    Manage employee accounts, departments and vehicle
                    booking permissions.
                </p>
                @Html.ActionLink(
                    "Manage Employees →",
                    "Index",
                    "UserManagement",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128203;</div>
                <h3>Vehicle Inspections</h3>
                <p>
                    Review vehicle condition records and inspection
                    information before and after bookings.
                </p>
                @Html.ActionLink(
                    "Manage Inspections →",
                    "Manage",
                    "VehicleInspection",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#127970;</div>
                <h3>Department Management</h3>
                <p>
                    Organise company departments and keep employee
                    department records up to date.
                </p>
                @Html.ActionLink(
                    "Manage Departments →",
                    "Index",
                    "Department",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128100;</div>
                <h3>My Profile</h3>
                <p>
                    View your account details and employee information.
                </p>
                @Html.ActionLink(
                    "View My Profile →",
                    "Index",
                    "Profile",
                    null,
                    new { @class = "feature-link" })
            </article>
        }
        else if (Request.IsAuthenticated)
        {
            <article class="feature-card">
                <div class="feature-icon">&#128203;</div>
                <h3>My Bookings</h3>
                <p>
                    View your vehicle requests and check their current status.
                </p>
                @Html.ActionLink(
                    "View My Bookings →",
                    "Index",
                    "Booking",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128663;</div>
                <h3>Request a Vehicle</h3>
                <p>
                    Submit a booking request with your travel purpose
                    and required dates.
                </p>
                @Html.ActionLink(
                    "Request a Vehicle →",
                    "Create",
                    "Booking",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128197;</div>
                <h3>Vehicle Availability</h3>
                <p>
                    Check the available fleet before planning your trip.
                </p>
                @Html.ActionLink(
                    "Check Availability →",
                    "Availability",
                    "Vehicle",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128100;</div>
                <h3>My Profile</h3>
                <p>
                    View your employee information and account details.
                </p>
                @Html.ActionLink(
                    "View My Profile →",
                    "Index",
                    "Profile",
                    null,
                    new { @class = "feature-link" })
            </article>
        }
        else
        {
            <article class="feature-card">
                <div class="feature-icon">&#128274;</div>
                <h3>Secure Employee Access</h3>
                <p>
                    Sign in to access the vehicle booking features
                    available to your account.
                </p>
                @Html.ActionLink(
                    "Sign In →",
                    "Login",
                    "Account",
                    null,
                    new { @class = "feature-link" })
            </article>

            <article class="feature-card">
                <div class="feature-icon">&#128663;</div>
                <h3>Fleet Availability</h3>
                <p>
                    Explore the vehicle availability page to view fleet
                    information where public access is permitted.
                </p>
                @Html.ActionLink(
                    "View Fleet →",
                    "Availability",
                    "Vehicle",
                    null,
                    new { @class = "feature-link" })
            </article>
        }

    </div>

    <div class="home-footer">
        Company Vehicle Booking System &copy; @DateTime.Now.Year
        <br />
        Efficient bookings. Responsible fleet management.
    </div>

</div>