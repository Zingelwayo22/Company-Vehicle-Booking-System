@model CompanyVehicleBookingSystem.Models.Booking

@{
    ViewBag.Title = "Review Booking";

    var beforeInspection = Model.Inspections
        .FirstOrDefault(i => i.InspectionType == "Before");

    var afterInspection = Model.Inspections
        .FirstOrDefault(i => i.InspectionType == "After");
}

<div class="review-page">

    <!-- PAGE HEADER -->

    <div class="review-header">

        <div>

            <span class="page-eyebrow">
                BOOKING ADMINISTRATION
            </span>

            <h2>
                Review Booking Request
            </h2>

            <p>
                Review the employee, vehicle and trip information before making a decision.
            </p>

        </div>

        <div class="header-booking-number">

            <span>BOOKING</span>

            <strong>
                #@Model.BookingId
            </strong>

        </div>

    </div>


    <!-- MESSAGES -->

    @if (TempData["Success"] != null)
    {
        <div class="modern-alert success-alert">
            <span class="alert-icon">✓</span>
            <div>
                <strong>Success</strong>
                <p>@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="modern-alert error-alert">
            <span class="alert-icon">!</span>
            <div>
                <strong>Action Required</strong>
                <p>@TempData["Error"]</p>
            </div>
        </div>
    }


    <!-- STATUS BANNER -->

    <div class="status-banner">

        <div class="status-banner-left">

            <div class="status-icon">
                @if (Model.Status == "Pending")
                {
                    <span>⏳</span>
                }
                else if (Model.Status == "Approved")
                {
                    <span>✓</span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span>✕</span>
                }
                else if (Model.Status == "Completed")
                {
                    <span>✓</span>
                }
                else
                {
                    <span>●</span>
                }
            </div>

            <div>

                <span class="status-banner-label">
                    CURRENT BOOKING STATUS
                </span>

                <h3>
                    @if (Model.Status == "Pending")
                    {
                        <span>Pending Approval</span>
                    }
                    else
                    {
                        <span>@Model.Status</span>
                    }
                </h3>

            </div>

        </div>


        <div class="status-date">

            <span>REQUESTED ON</span>

            <strong>
                @Model.DateCreated.ToString("dd/MM/yyyy HH:mm")
            </strong>

        </div>

    </div>


    <!-- MAIN GRID -->

    <div class="review-grid">

        <!-- EMPLOYEE CARD -->

        <div class="review-card">

            <div class="card-heading">

                <div class="heading-icon employee-icon">
                    👤
                </div>

                <div>

                    <h3>Employee Information</h3>

                    <p>
                        Employee who submitted this request.
                    </p>

                </div>

            </div>


            <div class="employee-profile">

                <div class="employee-avatar">

                    @if (Model.User != null)
                    {
                        @Model.User.FirstName.Substring(0, 1).ToUpper()
                        @Model.User.LastName.Substring(0, 1).ToUpper()
                    }
                    else
                    {
                        <span>?</span>
                    }

                </div>

                <div>

                    <h4>
                        @Model.User.FirstName @Model.User.LastName
                    </h4>

                    <span>
                        @(Model.User.Email ?? "No email available")
                    </span>

                </div>

            </div>


            <div class="information-list">

                <div class="information-row">

                    <span>Employee Number</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.User.EmployeeNumber)
                            ? "Not assigned"
                            : Model.User.EmployeeNumber)
                    </strong>

                </div>

                <div class="information-row">

                    <span>Department</span>

                    <strong>
                        @(Model.User.Department != null
                            ? Model.User.Department.Name
                            : "Not Assigned")
                    </strong>

                </div>

                <div class="information-row">

                    <span>Email</span>

                    <strong class="break-text">
                        @Model.User.Email
                    </strong>

                </div>

            </div>

        </div>


        <!-- VEHICLE CARD -->

        <div class="review-card">

            <div class="card-heading">

                <div class="heading-icon vehicle-icon">
                    🚗
                </div>

                <div>

                    <h3>Vehicle Information</h3>

                    <p>
                        Vehicle requested for this booking.
                    </p>

                </div>

            </div>


            <div class="vehicle-review">

                @if (Model.Vehicle != null &&
                     !string.IsNullOrWhiteSpace(Model.Vehicle.ImagePath))
                {
                    <img src="@Url.Content(Model.Vehicle.ImagePath)"
                         alt="@Model.Vehicle.RegistrationNumber"
                         class="review-vehicle-image" />
                }
                else
                {
                    <div class="review-vehicle-placeholder">
                        🚗
                    </div>
                }


                <div class="vehicle-review-info">

                    <h4>
                        @Model.Vehicle.Make @Model.Vehicle.Model
                    </h4>

                    <span class="registration-badge">
                        @Model.Vehicle.RegistrationNumber
                    </span>

                </div>

            </div>


            <div class="information-list">

                <div class="information-row">

                    <span>Vehicle ID</span>

                    <strong>
                        @Model.Vehicle.VehicleId
                    </strong>

                </div>

                <div class="information-row">

                    <span>Status</span>

                    <strong>
                        @Model.Vehicle.Status
                    </strong>

                </div>

                <div class="information-row">

                    <span>Year</span>

                    <strong>
                        @Model.Vehicle.Year
                    </strong>

                </div>

                <div class="information-row">

                    <span>Colour</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Vehicle.Colour)
                            ? "Not specified"
                            : Model.Vehicle.Colour)
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- TRIP INFORMATION -->

    <div class="review-card full-width-card">

        <div class="card-heading">

            <div class="heading-icon trip-icon">
                📅
            </div>

            <div>

                <h3>Trip Information</h3>

                <p>
                    Requested booking period and travel requirements.
                </p>

            </div>

        </div>


        <div class="trip-dates">

            <div class="date-card">

                <span class="date-label">
                    START DATE & TIME
                </span>

                <strong>
                    @Model.StartDateTime.ToString("dd/MM/yyyy")
                </strong>

                <span class="date-time">
                    @Model.StartDateTime.ToString("HH:mm")
                </span>

            </div>


            <div class="trip-arrow">
                →
            </div>


            <div class="date-card">

                <span class="date-label">
                    END DATE & TIME
                </span>

                <strong>
                    @Model.EndDateTime.ToString("dd/MM/yyyy")
                </strong>

                <span class="date-time">
                    @Model.EndDateTime.ToString("HH:mm")
                </span>

            </div>

        </div>

    </div>


    <!-- REASONS -->

    <div class="review-grid">

        <div class="review-card">

            <div class="card-heading">

                <div class="heading-icon reason-icon">
                    📋
                </div>

                <div>

                    <h3>Reason for Vehicle</h3>

                    <p>
                        Why the employee needs a company vehicle.
                    </p>

                </div>

            </div>

            <div class="reason-content">

                @if (!string.IsNullOrWhiteSpace(Model.ReasonForVehicle))
                {
                    @Model.ReasonForVehicle
                }
                else
                {
                    <span class="not-provided">
                        No reason provided.
                    </span>
                }

            </div>

        </div>


        <div class="review-card">

            <div class="card-heading">

                <div class="heading-icon reason-icon">
                    🎯
                </div>

                <div>

                    <h3>Vehicle Selection Reason</h3>

                    <p>
                        Why this particular vehicle was selected.
                    </p>

                </div>

            </div>

            <div class="reason-content">

                @if (!string.IsNullOrWhiteSpace(Model.VehicleSelectionReason))
                {
                    @Model.VehicleSelectionReason
                }
                else
                {
                    <span class="not-provided">
                        No reason provided.
                    </span>
                }

            </div>

        </div>

    </div>


    <!-- ADMIN DECISION -->

    @if (Model.Status == "Pending")
    {
        <div class="decision-card">

            <div class="decision-header">

                <div>

                    <span class="page-eyebrow">
                        ADMINISTRATOR ACTION
                    </span>

                    <h3>
                        Make a Decision
                    </h3>

                    <p>
                        Review all booking information carefully before approving or rejecting this request.
                    </p>

                </div>

            </div>


            <div class="decision-grid">

                <!-- APPROVE -->

                <div class="decision-option approve-option">

                    <div class="decision-icon">
                        ✓
                    </div>

                    <h4>
                        Approve Booking
                    </h4>

                    <p>
                        Approving this request will reserve the selected vehicle for the requested booking period.
                    </p>

                    @using (Html.BeginForm(
                        "Approve",
                        "Booking",
                        new { id = Model.BookingId },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="decision-button approve-button">

                            Approve Booking

                        </button>
                    }

                </div>


                <!-- REJECT -->

                <div class="decision-option reject-option">

                    <div class="decision-icon">
                        ✕
                    </div>

                    <h4>
                        Reject Booking
                    </h4>

                    <p>
                        A reason must be provided when rejecting a booking request.
                    </p>

                    @using (Html.BeginForm(
                        "Reject",
                        "Booking",
                        new { id = Model.BookingId },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="rejection-field">

                            <label for="rejectionReason">
                                Reason for Rejection
                            </label>

                            <textarea name="rejectionReason"
                                      id="rejectionReason"
                                      rows="4"
                                      placeholder="Enter the reason for rejecting this booking..."
                                      required></textarea>

                        </div>

                        <button type="submit"
                                class="decision-button reject-button">

                            Reject Booking

                        </button>
                    }

                </div>

            </div>

        </div>
    }


    <!-- APPROVED INFORMATION -->

    @if (Model.Status == "Approved")
    {
        <div class="outcome-card approved-card">

            <div class="outcome-icon">
                ✓
            </div>

            <div class="outcome-content">

                <span class="outcome-label">
                    BOOKING APPROVED
                </span>

                <h3>
                    This booking has been approved
                </h3>

                <p>
                    The vehicle is reserved for the requested period.
                    Once the employee has returned the vehicle, mark the booking as completed.
                </p>

                @if (Model.ApprovedDate.HasValue)
                {
                    <div class="outcome-date">

                        <span>Approved On</span>

                        <strong>
                            @Model.ApprovedDate.Value.ToString("dd/MM/yyyy HH:mm")
                        </strong>

                    </div>
                }


                <div class="completion-section">

                    <div>

                        <h4>
                            Booking Completion
                        </h4>

                        <p>
                            Mark the booking as completed after the vehicle has been returned.
                            This will allow the after-trip inspection to be recorded.
                        </p>

                    </div>

                    @using (Html.BeginForm(
                        "Complete",
                        "Booking",
                        new { id = Model.BookingId },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="complete-button"
                                onclick="return confirm('Are you sure you want to mark this booking as completed?');">

                            Mark as Completed

                        </button>
                    }

                </div>

            </div>

        </div>
    }


    <!-- REJECTED INFORMATION -->

    @if (Model.Status == "Rejected")
    {
        <div class="outcome-card rejected-card">

            <div class="outcome-icon">
                ✕
            </div>

            <div class="outcome-content">

                <span class="outcome-label">
                    BOOKING REJECTED
                </span>

                <h3>
                    This booking request was rejected
                </h3>

                <div class="rejection-display">

                    <span>
                        Reason for Rejection
                    </span>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.RejectionReason)
                            ? "No rejection reason recorded."
                            : Model.RejectionReason)
                    </p>

                </div>

                @if (Model.RejectedDate.HasValue)
                {
                    <div class="outcome-date">

                        <span>Rejected On</span>

                        <strong>
                            @Model.RejectedDate.Value.ToString("dd/MM/yyyy HH:mm")
                        </strong>

                    </div>
                }

            </div>

        </div>
    }


    <!-- VEHICLE INSPECTIONS -->

    <div class="review-card full-width-card">

        <div class="card-heading">

            <div class="heading-icon inspection-icon">
                🔍
            </div>

            <div>

                <h3>Vehicle Inspections</h3>

                <p>
                    Record and review the vehicle condition before and after the booking.
                </p>

            </div>

        </div>


        <div class="inspection-grid">

            <!-- BEFORE -->

            <div class="inspection-card">

                <div class="inspection-header">

                    <div>

                        <span class="inspection-label">
                            BEFORE TRIP
                        </span>

                        <h4>
                            Pre-Trip Inspection
                        </h4>

                    </div>

                    @if (beforeInspection != null)
                    {
                        <span class="inspection-status completed">
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="inspection-status pending">
                            Not Completed
                        </span>
                    }

                </div>


                @if (beforeInspection == null)
                {
                    <div class="inspection-empty">

                        <div class="empty-icon">
                            🔍
                        </div>

                        <p>
                            The before-trip inspection has not yet been completed.
                        </p>

                        @if (Model.Status == "Approved")
                        {
                            @Html.ActionLink(
                                "Perform Before Inspection",
                                "Create",
                                "VehicleInspection",
                                new
                                {
                                    bookingId = Model.BookingId,
                                    type = "Before"
                                },
                                new
                                {
                                    @class = "inspection-button"
                                }
                            )
                        }
                        else
                        {
                            <span class="inspection-disabled">
                                Booking must be approved first
                            </span>
                        }

                    </div>
                }
                else
                {
                    <div class="inspection-details">

                        <div class="inspection-detail-row">

                            <span>Inspection Date</span>

                            <strong>
                                @beforeInspection.InspectionDate.ToString("dd/MM/yyyy HH:mm")
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Mileage</span>

                            <strong>
                                @(beforeInspection.Mileage.HasValue
                                    ? beforeInspection.Mileage.Value.ToString("N0") + " km"
                                    : "Not recorded")
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Scratches</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(beforeInspection.Scratches)
                                    ? "None recorded"
                                    : beforeInspection.Scratches)
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Dents</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(beforeInspection.Dents)
                                    ? "None recorded"
                                    : beforeInspection.Dents)
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Other Damage</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(beforeInspection.OtherDamage)
                                    ? "None recorded"
                                    : beforeInspection.OtherDamage)
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>General Condition</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(beforeInspection.GeneralCondition)
                                    ? "Not recorded"
                                    : beforeInspection.GeneralCondition)
                            </strong>

                        </div>

                    </div>
                }

            </div>


            <!-- AFTER -->

            <div class="inspection-card">

                <div class="inspection-header">

                    <div>

                        <span class="inspection-label">
                            AFTER TRIP
                        </span>

                        <h4>
                            Post-Trip Inspection
                        </h4>

                    </div>

                    @if (afterInspection != null)
                    {
                        <span class="inspection-status completed">
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="inspection-status pending">
                            Not Completed
                        </span>
                    }

                </div>


                @if (afterInspection == null)
                {
                    <div class="inspection-empty">

                        <div class="empty-icon">
                            🔍
                        </div>

                        <p>
                            The after-trip inspection has not yet been completed.
                        </p>

                        @if (Model.Status == "Completed")
                        {
                            @Html.ActionLink(
                                "Perform After Inspection",
                                "Create",
                                "VehicleInspection",
                                new
                                {
                                    bookingId = Model.BookingId,
                                    type = "After"
                                },
                                new
                                {
                                    @class = "inspection-button"
                                }
                            )
                        }
                        else
                        {
                            <span class="inspection-disabled">
                                Available after booking completion
                            </span>
                        }

                    </div>
                }
                else
                {
                    <div class="inspection-details">

                        <div class="inspection-detail-row">

                            <span>Inspection Date</span>

                            <strong>
                                @afterInspection.InspectionDate.ToString("dd/MM/yyyy HH:mm")
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Mileage</span>

                            <strong>
                                @(afterInspection.Mileage.HasValue
                                    ? afterInspection.Mileage.Value.ToString("N0") + " km"
                                    : "Not recorded")
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Scratches</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(afterInspection.Scratches)
                                    ? "None recorded"
                                    : afterInspection.Scratches)
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Dents</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(afterInspection.Dents)
                                    ? "None recorded"
                                    : afterInspection.Dents)
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>Other Damage</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(afterInspection.OtherDamage)
                                    ? "None recorded"
                                    : afterInspection.OtherDamage)
                            </strong>

                        </div>

                        <div class="inspection-detail-row">

                            <span>General Condition</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(afterInspection.GeneralCondition)
                                    ? "Not recorded"
                                    : afterInspection.GeneralCondition)
                            </strong>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- FOOTER NAVIGATION -->

    <div class="page-footer-actions">

        @Html.ActionLink(
            "← Back to Booking Management",
            "AdminIndex",
            "Booking",
            null,
            new { @class = "back-button" }
        )

    </div>

</div>


<style>

    .review-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 10px 0 45px;
    }


    /* HEADER */

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 25px;
    }

    .page-eyebrow {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .review-header h2 {
        margin: 0;
        color: #172033;
        font-size: 30px;
        font-weight: 700;
    }

    .review-header p {
        margin: 7px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .header-booking-number {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

        .header-booking-number span {
            color: #9ca3af;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .header-booking-number strong {
            color: #111827;
            font-size: 22px;
        }


    /* ALERTS */

    .modern-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px 18px;
        border-radius: 10px;
        margin-bottom: 18px;
        border: 1px solid;
    }

        .modern-alert strong {
            display: block;
            margin-bottom: 3px;
            font-size: 14px;
        }

        .modern-alert p {
            margin: 0;
            font-size: 13px;
        }

    .alert-icon {
        width: 27px;
        height: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 700;
        flex-shrink: 0;
    }

    .success-alert {
        background: #f0fdf4;
        border-color: #bbf7d0;
        color: #166534;
    }

        .success-alert .alert-icon {
            background: #dcfce7;
        }

    .error-alert {
        background: #fef2f2;
        border-color: #fecaca;
        color: #991b1b;
    }

        .error-alert .alert-icon {
            background: #fee2e2;
        }


    /* STATUS BANNER */

    .status-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    }

    .status-banner-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .status-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 20px;
    }

    .status-banner-label,
    .status-date span {
        display: block;
        color: #9ca3af;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .status-banner h3 {
        margin: 0;
        color: #1f2937;
        font-size: 18px;
        font-weight: 700;
    }

    .status-date {
        text-align: right;
    }

        .status-date strong {
            color: #374151;
            font-size: 13px;
        }


    /* MAIN GRID */

    .review-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .review-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    }

    .full-width-card {
        margin-bottom: 20px;
    }


    /* CARD HEADINGS */

    .card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 22px;
        background: #fafafa;
        border-bottom: 1px solid #e5e7eb;
    }

    .heading-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .employee-icon {
