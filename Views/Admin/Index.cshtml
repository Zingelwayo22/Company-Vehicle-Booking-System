@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="container">
    <h2>Admin Dashboard</h2>

    <p>Welcome to the Company Vehicle Booking System.</p>

    <hr />

    <div class="row">

        <div class="col-md-3">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    Employees
                </div>
                <div class="panel-body">
                    <h3>0</h3>
                    <p>Total Employees</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-success">
                <div class="panel-heading">
                    Vehicles
                </div>
                <div class="panel-body">
                    <h3>0</h3>
                    <p>Total Vehicles</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    Pending Bookings
                </div>
                <div class="panel-body">
                    <h3>0</h3>
                    <p>Awaiting Approval</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="panel panel-info">
                <div class="panel-heading">
                    Active Bookings
                </div>
                <div class="panel-body">
                    <h3>0</h3>
                    <p>Currently Active</p>
                </div>
            </div>
        </div>

    </div>
</div>

